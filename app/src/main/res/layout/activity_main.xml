<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Rive Animation Header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <app.rive.runtime.kotlin.RiveAnimationView
                    android:id="@+id/riveAnimation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:riveResource="@raw/nature"
                    app:riveFit="FIT_WIDTH" />

                <!-- Glassmorphism / Matte Overlay to hide baked-in toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#CCFFFFFF"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:layout_gravity="top">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENQUIRY AUTO RESPONDER"
                            android:textColor="#111111"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/tenor_sans" />

                        <TextView
                            android:id="@+id/tvVersionTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="v8.0.26 — Banner Image &amp; Dynamic AI Update"
                            android:textColor="#8C0C8E"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnAppInfo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="#111111"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="App Info"
                        android:padding="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:text="NO NEED TO SEE THE ABYSS"
                    android:textColor="#FFEA00"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:shadowColor="#CC000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE MODULES"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Module 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#1A1D24"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cardCornerRadius="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CALL CAPTURE TO SHEET"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INSTANT EVENT-DRIVEN CAPTURE"
                            android:textColor="#888888"
                            android:textSize="10sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchCallCapture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="#00E5FF"
                        app:trackTint="#333333" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Module 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#1A1D24"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cardCornerRadius="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WHATSAPP AI RECEPTIONIST"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENGINE: CLOUD-API-V1"
                            android:textColor="#888888"
                            android:textSize="10sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWaAi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="#00E5FF"
                        app:trackTint="#333333" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Module 3: Low Battery Call Reminder -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#1A1D24"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cardCornerRadius="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LOW BATTERY AUTO-CALL REMINDER"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CALLS AT 30%, 20%, 10%, &lt;5%"
                                android:textColor="#888888"
                                android:textSize="10sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchBatteryAlert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="#00E5FF"
                            app:trackTint="#333333" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/inputBatteryPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Target Phone (6380066280)"
                            android:textColorHint="#555555"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:backgroundTint="#00E5FF"
                            android:inputType="phone" />

                        <Button
                            android:id="@+id/btnSaveBatteryPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SAVE"
                            android:backgroundTint="#333333"
                            android:textColor="#FFFFFF"
                            app:cornerRadius="0dp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERMISSIONS HEALTH"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Permissions Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissionsAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#1A1D24"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cardCornerRadius="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/permCall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="[ SYS.CHECK ] Initializing..."
                        android:textColor="#FF8A80"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnGrantCallPerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GRANT MISSING PERMS"
                        android:backgroundTint="#00E5FF"
                        android:textColor="#000000"
                        app:cornerRadius="0dp" />

                    <Button
                        android:id="@+id/btnGrantAccessibility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ENABLE AUTO-SENDER (GHOST)"
                        android:backgroundTint="#00E5FF"
                        android:textColor="#000000"
                        app:cornerRadius="0dp"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/btnGrantNotification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ENABLE AI LISTENER"
                        android:backgroundTint="#00E5FF"
                        android:textColor="#000000"
                        app:cornerRadius="0dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI CONFIGURATION"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp" />

            <!-- AI Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#1A1D24"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cardCornerRadius="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <EditText
                        android:id="@+id/inputApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Paste Groq API Key (gsk_...)"
                        android:textColorHint="#555555"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:backgroundTint="#00E5FF"
                        android:inputType="textPassword" />

                    <Button
                        android:id="@+id/btnSaveApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SAVE KEY"
                        android:backgroundTint="#333333"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="0dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE ACTIVITY LOG"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Logs Terminal -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#0F1115"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cardCornerRadius="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1A1D24"
                        android:padding="8dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="STREAM: WA_AGENT_CORE"
                            android:textColor="#00E5FF"
                            android:textSize="10sp"
                            android:fontFamily="monospace" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:text="● LIVE"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                        <ImageView
                            android:id="@+id/btnRefreshLogs"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_popup_sync"
                            app:tint="#00E5FF"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

                    <TextView
                        android:id="@+id/logText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="150dp"
                        android:padding="12dp"
                        android:text="[SYSTEM] Initializing..."
                        android:textColor="#BBBBBB"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            
            <Button
                android:id="@+id/btnViewFullLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="VIEW FULL LOG"
                android:textColor="#00E5FF"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
